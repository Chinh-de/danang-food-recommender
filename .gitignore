# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---------- Node (frontend; frontend/.gitignore có thêm quy tắc riêng) ----------
node_modules/
dist/
*.local
*.tsbuildinfo

# ---------- Dữ liệu sinh ra ----------
# Tạo lại bằng: cd backend && uv run scripts/prepare_data.py
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# artifacts/ (tham số mô hình, khoảng 2,5 MB) được giữ trong git để clone về chạy được ngay

# ---------- Môi trường, nhật ký, editor ----------
.env
.env.*
!.env.example
*.log
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
